# Copia este archivo a .env y rellena los valores reales.
# Las variables EXPO_PUBLIC_* se inyectan en el bundle JS (no pongas secretos de servidor aquí).

# Supabase (mismo proyecto que la PWA vegantrack)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Base de la PWA / API Vercel
EXPO_PUBLIC_WEB_BASE_URL=https://vegantrack.app

# RevenueCat — Google Play Billing (Android)
# Obtén esta clave en app.revenuecat.com → tu proyecto → API Keys → Public (Android)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry — crash reporting y ErrorBoundary raíz (ver src/lib/errorReporting.ts)
# DSN público del proyecto: sentry.io → Settings → Projects → tu proyecto → Client Keys (DSN)
# Al igual que la anon key de Supabase, el DSN está pensado para ir en el cliente:
# no es un secreto, sólo identifica a dónde se envían los eventos.
# Si se deja vacío, el crash reporting queda desactivado sin romper el arranque.
EXPO_PUBLIC_SENTRY_DSN=
