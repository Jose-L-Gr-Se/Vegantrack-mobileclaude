{
  "expo": {
    "name": "VegeTrack",
    "slug": "vegantrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vegantrack",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f5d41"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vegantrack.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:vegantrack.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "es",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.vegantrack.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#2f5d41",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vegantrack.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fa0d891c-6cef-4daf-b24a-68a702652b7c"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2f5d41"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "VegeTrack usa Face ID únicamente para proteger el acceso seguro a tu sesión."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2f5d41"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VegeTrack usa la cámara para escanear códigos de barras de alimentos.",
          "microphonePermission": "VegeTrack no graba audio; este permiso lo requiere el componente de cámara de iOS."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VegeTrack usa tus fotos para analizar platos y calcular sus nutrientes.",
          "cameraPermission": "VegeTrack usa la cámara para fotografiar tus platos y analizarlos con IA.",
          "microphonePermission": "VegeTrack no graba audio; este permiso lo requiere el componente de cámara de iOS."
        }
      ]
    ]
  }
}
